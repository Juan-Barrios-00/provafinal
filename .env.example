# Copie para .env e preencha com os seus dados.
# Supabase > Project Settings > Database > Connection string (Session pooler)
SUPABASE_DB_URL=jdbc:postgresql://SEU_HOST_DO_POOLER:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.SEU_PROJECT_REF
SUPABASE_DB_PASSWORD=sua-senha
ADMIN_TOKEN=um-token-secreto-seu
